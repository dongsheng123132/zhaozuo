{
  "$schema": "../schema/compatibility-action-profile.schema.json",
  "profile_version": "0.1",
  "profile_id": "windows.wps-writer.learning-demo",
  "kind": "external_ui_adapter",
  "status": "draft",
  "application": {
    "id": "cn.wps.writer",
    "name": "WPS 文字",
    "platform": "windows",
    "observed_version": "12.1.0.26895",
    "discovery": {
      "process_names": ["wps.exe"],
      "executable_candidates": [
        "%LOCALAPPDATA%/Kingsoft/WPS Office/12.1.0.26895/office6/wps.exe",
        "%LOCALAPPDATA%/Kingsoft/WPS Office/*/office6/wps.exe",
        "%PROGRAMFILES%/Kingsoft/WPS Office/*/office6/wps.exe",
        "%PROGRAMFILES(X86)%/Kingsoft/WPS Office/*/office6/wps.exe"
      ],
      "window": {
        "control_type": "Window",
        "title_regex": ".*(WPS|文字).*"
      }
    }
  },
  "actions": {
    "document.create_and_save": {
      "title": "新建并保存文档",
      "description": "打开 WPS 文字，新建空白文档，输入正文并保存到新路径。",
      "input_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "要输入的文档正文；执行日志必须遮蔽"
          },
          "output_path": {
            "type": "string",
            "description": "新文件的绝对路径；第一版拒绝覆盖已有文件"
          }
        },
        "required": ["content", "output_path"],
        "additionalProperties": false
      },
      "risk": "low",
      "confirmation": "before_effect",
      "preconditions": [
        "WPS Writer is installed",
        "output_path is absolute",
        "output_path does not already exist"
      ],
      "steps": [
        {
          "id": "launch_or_focus",
          "kind": "app.launch_or_focus",
          "timeout_ms": 15000,
          "args": {
            "process_names": ["wps.exe"],
            "executable_candidates": [
              "%LOCALAPPDATA%/Kingsoft/WPS Office/12.1.0.26895/office6/wps.exe",
              "%LOCALAPPDATA%/Kingsoft/WPS Office/*/office6/wps.exe",
              "%PROGRAMFILES%/Kingsoft/WPS Office/*/office6/wps.exe"
            ]
          }
        },
        {
          "id": "create_blank_document",
          "kind": "uia.invoke",
          "timeout_ms": 10000,
          "locator": {
            "control_type_any": ["Button", "ListItem"],
            "name_any": ["新建", "空白文档", "New", "Blank document"]
          },
          "fallback": [
            {
              "kind": "keyboard.shortcut",
              "args": { "keys": ["CTRL", "N"] }
            }
          ]
        },
        {
          "id": "focus_editor",
          "kind": "uia.focus",
          "timeout_ms": 10000,
          "locator": {
            "control_type_any": ["Document", "Edit"],
            "within_process": "wps.exe"
          }
        },
        {
          "id": "type_content",
          "kind": "keyboard.type",
          "args": { "text": "${content}" },
          "log_policy": "redact"
        },
        {
          "id": "open_save_as",
          "kind": "keyboard.shortcut",
          "args": { "keys": ["CTRL", "SHIFT", "S"] }
        },
        {
          "id": "wait_for_save_dialog",
          "kind": "window.wait",
          "timeout_ms": 10000,
          "locator": {
            "control_type": "Window",
            "name_any": ["另存为", "Save As"]
          }
        },
        {
          "id": "set_output_path",
          "kind": "uia.set_value",
          "locator": {
            "control_type": "Edit",
            "automation_id_any": ["1001", "FileNameControlHost"],
            "name_any": ["文件名", "File name"]
          },
          "args": { "value": "${output_path}" },
          "log_policy": "normal"
        },
        {
          "id": "save",
          "kind": "uia.invoke",
          "locator": {
            "control_type": "Button",
            "name_any": ["保存", "Save"]
          }
        }
      ],
      "success_evidence": [
        {
          "kind": "file.exists",
          "path": "${output_path}"
        },
        {
          "kind": "file.size_greater_than",
          "path": "${output_path}",
          "bytes": 0
        }
      ],
      "learned_from": []
    }
  }
}
